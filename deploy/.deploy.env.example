# Copy this file to deploy/.deploy.env and fill in real values.
# deploy/.deploy.env is gitignored.

DEPLOY_HOST=your-server-ip
DEPLOY_USER=root
SSH_KEY=/absolute/path/to/your-key.pem

APP_DIR=/opt/property-hunt
